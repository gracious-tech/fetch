{
    // Type check test files (excluded from each workspace's own tsconfig so they aren't built)
    // NOTE app/ and site/ aren't built by tsc, so their own tsconfigs already check their tests
    "extends": "./tsconfig_base.jsonc",
    "include": ["*/src/**/*.test.ts", "converters/*/src/**/*.test.ts", "*/src/**/test_utils.ts"],
    "exclude": ["app/**", "site/**"],
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "noEmit": true,
    },
}
